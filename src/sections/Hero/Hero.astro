---
import "./Hero.scss";
import ArrowIcon from "../../assets/icons/arrow.svg";
import WhatsappIcon from "../../components/WhatsappIcon/WhatsappIcon.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher/LanguageSwitcher.astro";
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const bookingHref = localizedPath(lang, "booking");
---

<section class="Hero">
  <video
    class="Hero__backgroundVideo"
    src="/vid/hero.webm"
    poster="/img/hero.webp"
    autoplay
    muted
    loop
    playsinline
  >
    <source src="/vid/hero.webm" type="video/webm" />
    <source src="/vid/hero.mp4" type="video/mp4" />
  </video>
  <header class="Hero__header">
    <div class="Hero__buttonsTop">
      <a class="animate-fill" href={bookingHref}>
        <ArrowIcon />
        {t.nav.bookNow}
      </a>
      <button class="button--icon animate-fill" type="button" aria-label={t.cta.whatsapp}>
        <WhatsappIcon />
      </button>
      <LanguageSwitcher route="home" />
    </div>
    <div class="Hero__logoWrapper"></div>
    <div class="Hero__navContainer">
      <button class="Hero__navOpen button--icon">☰</button>
      <nav class="Hero__nav">
        <button class="Hero__navClose" type="button" aria-label="Close">
          ×
        </button>
        <a class="Hero__navLink" href="#flights">{t.nav.prices}</a>
        <a class="Hero__navLink" href="#faq">{t.nav.faq}</a>
        <a class="Hero__navLink" href="#contact">{t.nav.contact}</a>
        <div class="Hero__navBody">
          <div class="Hero__navLanguage">
            <LanguageSwitcher route="home" />
          </div>
          <div class="Hero__navContact">
            <span class="Hero__navContactLabel">{t.nav.contact}</span>
            <a class="Hero__navContactLink" href={`mailto:${t.footer.email}`}>
              {t.footer.email}
            </a>
            <a
              class="Hero__navContactLink"
              href={`tel:${t.footer.phone.replace(/\s/g, "")}`}
            >
              {t.footer.phone}
            </a>
          </div>
        </div>
        <div class="Hero__navLegal">
          <a href="#">{t.footer.impressum}</a>
          <a href="#">{t.footer.privacy}</a>
          <a href="#">{t.footer.cookies}</a>
        </div>
      </nav>
      <script>
        const openNavButton = document.querySelector(".Hero__navOpen");
        const closeNavButton = document.querySelector(".Hero__navClose");
        const body = document.body;
        const nav = document.querySelector(".Hero__nav");

        const closeNav = () => {
          nav?.classList.remove("is-open");
          body.style.overflow = "visible";
        };

        openNavButton?.addEventListener("click", () => {
          nav?.classList.toggle("is-open");
          body.style.overflow = "hidden";
        });
        closeNavButton?.addEventListener("click", closeNav);
        nav?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeNav);
        });
      </script>
    </div>
  </header>

  <div>
    <h1 class="Hero__title">
      {t.hero.titlePre} <span class="Hero__title--highlight">{t.hero.titleHighlight}</span>
    </h1>
    <h2 class="Hero__subtitle">{t.hero.subtitle}</h2>
    <div class="Hero__buttonsBottom">
      <a class="Hero__ctaButton animate-fill" href={bookingHref}>
        <ArrowIcon />
        {t.nav.bookNow}
      </a>
      <button class="Hero__whatsappButton button--icon animate-fill" type="button" aria-label={t.cta.whatsapp}>
        <WhatsappIcon />
      </button>
    </div>
  </div>
</section>
