---
import "./Hero.scss";
import ArrowIcon from "../../assets/icons/arrow.svg";
import WhatsappIcon from "../../components/WhatsappIcon/WhatsappIcon.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher/LanguageSwitcher.astro";
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const bookingHref = localizedPath(lang, "booking");
---

<section class="Hero">
  <video
    class="Hero__backgroundVideo"
    src="/tandem-v3/vid/hero.webm"
    poster="/tandem-v3/img/hero.webp"
    autoplay
    muted
    loop
    playsinline
  >
    <source src="/tandem-v3/vid/hero.webm" type="video/webm" />
    <source src="/tandem-v3/vid/hero.mp4" type="video/mp4" />
  </video>
  <header class="Hero__header">
    <div class="Hero__buttonsTop">
      <a class="animate-fill" href={bookingHref}>
        <ArrowIcon />
        {t.nav.bookNow}
      </a>
      <button class="button--icon animate-fill" type="button" aria-label={t.cta.whatsapp}>
        <WhatsappIcon />
      </button>
      <LanguageSwitcher route="home" />
    </div>
    <div class="Hero__logoWrapper">logo</div>
    <div class="Hero__navContainer">
      <button class="Hero__navOpen button--icon">☰</button>
      <nav class="Hero__nav">
        <button class="Hero__navClose button--icon">x</button>
        <a href="#flights">{t.nav.prices}</a>
        <a href="#faq">{t.nav.faq}</a>
        <a href="#contact">{t.nav.contact}</a>
      </nav>
      <script>
        const openNavButton = document.querySelector(".Hero__navOpen");
        const closeNavButton = document.querySelector(".Hero__navClose");
        const body = document.body;
        const nav = document.querySelector(".Hero__nav");
        openNavButton?.addEventListener("click", () => {
          nav?.classList.toggle("is-open");
          body.style.overflow = "hidden";
        });
        closeNavButton?.addEventListener("click", () => {
          nav?.classList.remove("is-open");
          body.style.overflow = "visible";
        });
      </script>
    </div>
  </header>

  <div>
    <h1 class="Hero__title">
      {t.hero.titlePre} <span class="Hero__title--highlight">{t.hero.titleHighlight}</span>
    </h1>
    <h2 class="Hero__subtitle">{t.hero.subtitle}</h2>
    <div class="Hero__buttonsBottom">
      <a class="Hero__ctaButton animate-fill" href={bookingHref}>
        <ArrowIcon />
        {t.nav.bookNow}
      </a>
      <button class="Hero__whatsappButton button--icon animate-fill" type="button" aria-label={t.cta.whatsapp}>
        <WhatsappIcon />
      </button>
    </div>
  </div>
</section>
