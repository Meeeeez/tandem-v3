---
import "./Location.scss";
const { props } = Astro.props;
---

<section class="Location">
    <h3 class="Location__title">
    where do you <br class="Flights__titleBreakLine"> want to fly from
  </h3>
  <p class="Location__description">
    If Bradford matched Core City averages across key metrics, <b>productivity would rise to £37.80 per hour</b>, the business base would grow to nearly 20,000, and the working‑age population would increase.
  </p>
  <div class="Location__details">
    <div class="Location__detailsTopRow">
      <div class="Location__textSection Location__box">
        <span class="Location__cardBadge">Selected &bull; Plose</span>
        <h4 class="Location__cardTitle">Plose</h4>
        <p class="Location__cardSub">Our home mountain in South Tyrol. Reliable thermals, clean alpine air, and a panorama of the Dolomites that never gets old.</p>
        <ul class="Location__cardData">
          <li><span>Elevation</span><span>2,486 M</span></li>
          <li><span>Wind</span><span>NW &bull; 15 km/h</span></li>
          <li><span>Level</span><span>All levels</span></li>
        </ul>
        <a class="Location__cardButton" href="https://maps.app.goo.gl/plose" target="_blank" rel="noopener">Meeting Point ↗</a>
      </div>
      <video class="Location__imagery Location__box" src="/vid/plose_slow.mp4" autoplay playsinline muted loop></video>
    </div>
    <div id="map" class="Location__map Location__box"></div>
  </div>
</section>

<script>
  import L from "leaflet";
  import 'leaflet/dist/leaflet.css';
  const map = L.map('map').setView([51.505, -0.09], 13);
  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.esri.com">Esri</a>, Maxar, Earthstar Geographics'
  }).addTo(map);
</script>