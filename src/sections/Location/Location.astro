---
import Header from "../../components/Header/Header.astro";
import LocationCard from "../../components/LocationCard/LocationCard.astro";
import "./Location.scss";

interface LocationData {
  name: string;
  meta?: string;
  coordinates: [number, number];
  imageUrls: string[];
  googleMapsLink?: string;
}

interface Props {
  locations?: LocationData[];
}

const { locations = [] } = Astro.props;
---

<section class="Location">
  <div class="container">
    <Header
      title="where do you <br>want to"
      titleHighlighted="fly from"
      description="If Bradford matched Core City averages across key metrics, <b>productivity would rise to £37.80 per hour</b>, the business base would grow to nearly 20,000, and the working‑age population would increase."
      onPrimaryBackground
    />
    <div class="Location__details">
      <div class="Location__mapWrapper">
        <div class="Location__map"></div>

        <aside
          class="Location__popup"
          aria-hidden="true"
          aria-live="polite"
        >
          {
            locations.map((location, index) => (
              <LocationCard {...location} index={index} />
            ))
          }
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  import { initLocationMap } from "./LocationMap.ts";

  const initAllLocationMaps = () => {
    document
      .querySelectorAll<HTMLElement>(".Location__mapWrapper")
      .forEach((wrapper) => initLocationMap(wrapper));
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAllLocationMaps);
  } else {
    initAllLocationMaps();
  }
</script>
