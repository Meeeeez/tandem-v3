---
import Header from "../../components/Header/Header.astro";
import "./Location.scss";
const { props } = Astro.props;
---

<section class="Location">
  <Header
    title="where do you <br>want to"
    titleHighlighted="fly from"
    description="If Bradford matched Core City averages across key metrics, <b>productivity would rise to £37.80 per hour</b>, the business base would grow to nearly 20,000, and the working‑age population would increase."
    onPrimaryBackground
  />
  <div class="Location__details">
    <div id="map" class="Location__map Location__box"></div>
  </div>
</section>

<script>
  import L from "leaflet";
  import 'leaflet/dist/leaflet.css';

  const map = L.map('map', {
    maxBounds: L.latLngBounds(
      [46.380, 11.150], // SW
      [46.944, 12.225]  // NE
    ),
    maxBoundsViscosity: 0.75,
    center: [46.662051,11.687441],
    zoom: 11,
    minZoom: 11,
    maxZoom: 17,
    scrollWheelZoom: false
  });
  L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}').addTo(map);

  const container = map.getContainer();

  container.style.touchAction = 'pan-y';

  container.addEventListener('touchstart', (e) => {
    if (e.touches.length >= 2) {
      map.dragging.enable();
      container.style.touchAction = 'none'; // let Leaflet handle pinch
    } else {
      map.dragging.disable();
      container.style.touchAction = 'pan-y'; // let browser scroll the page
    }
  }, { passive: true }); // passive: true is critical here

  container.addEventListener('touchend', () => {
    map.dragging.disable();
    container.style.touchAction = 'pan-y';
  }, { passive: true });
</script>