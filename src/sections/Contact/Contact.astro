---
import ContactCard from "../../components/ContactCard/ContactCard.astro";
import ContactForm from "../../components/ContactForm/ContactForm.astro";
import Header from "../../components/Header/Header.astro";
import WhatsappIcon from "../../components/WhatsappIcon/WhatsappIcon.astro";
import "./Contact.scss";
---

<section class="Contact">
  <div class="container">
    <Header
      title="let's get you "
      titleHighlighted="in the air"
      description="Drop us a message — WhatsApp is fastest. We reply within the hour during flying season (Mar–Nov), or the next morning the rest of the year."
      onPrimaryBackground
    />
    <div class="Contact__content">
      <div class="Contact__cardContainer">
        <ContactCard
          title="+39 348 424 7767"
          subtitle="whatsapp"
          href="tel:+393484247767"
        >
          <WhatsappIcon slot="icon" />
        </ContactCard>
        <ContactCard
          title="info@flyguys.it"
          subtitle="email"
          href="mailto:info@flyguys.it"
        >
          <WhatsappIcon slot="icon" />
        </ContactCard>
      </div>
      <div class="Contact__contactForm">
        <ContactForm />
      </div>
    </div>
  </div>
</section>