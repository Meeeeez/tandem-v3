---
import "./About.scss";
import ArrowIcon from "../../assets/icons/arrow.svg";
---

<section class="About" id="about">
  <img class="About__background" src="/img/2.jpg" alt="" aria-hidden="true" />

  <div class="About__inner">
    <div class="About__content">
      <p class="About__overline">
        <span class="About__overlineDot" aria-hidden="true"></span>
        <span>ABOUT</span>
      </p>
      <h3 class="About__title">
        meet your <span class="About__titleHighlight">pilot</span>
      </h3>
      <p class="About__lead">
        Hi, I'm Luca — certified tandem pilot, mountain guide, and the
        person you'll be flying with.
      </p>
      <p class="About__body">
        I grew up in these valleys and started paragliding more than a
        decade ago. Today I share the sky with travellers, families, and
        first-timers who want to see the Dolomites from a perspective most
        people never get. Every flight is private, every briefing is
        unhurried, and we only fly when conditions are safe and smooth.
      </p>

      <button class="About__cta animate-fill">
        <ArrowIcon />
        Book a flight
      </button>
    </div>

    <ul class="About__stats">
      <li class="About__stat">
        <span class="About__statNumber">10+</span>
        <span class="About__statLabel">years flying<br />the Dolomites</span>
      </li>
      <li class="About__stat">
        <span class="About__statNumber">2 000+</span>
        <span class="About__statLabel">tandem flights<br />completed</span>
      </li>
      <li class="About__stat">
        <span class="About__statNumber">5★</span>
        <span class="About__statLabel">average guest<br />rating</span>
      </li>
      <li class="About__stat">
        <span class="About__statNumber">3</span>
        <span class="About__statLabel">languages —<br />DE / EN / IT</span>
      </li>
    </ul>
  </div>
</section>
