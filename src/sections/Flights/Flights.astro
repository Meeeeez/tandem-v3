---
import "./Flights.scss";
import ArrowIcon from "../../assets/icons/arrow.svg";
import FlightCard from "../../components/FlightCard/FlightCard.astro";
import Header from "../../components/Header/Header.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const flightMedia = [
  { image: "/tandem-v3/img/1.jpg", videoSrc: "/tandem-v3/vid/bg.mp4" },
  { image: "/tandem-v3/img/2.jpg", videoSrc: "/tandem-v3/vid/bg.mp4" },
  { image: "/tandem-v3/img/3.jpg", videoSrc: "/tandem-v3/vid/bg.mp4" },
];
---

<section class="Flights" id="flights">
  <div class="container">
    <Header
      title={t.flights.header.title}
      titleHighlighted={t.flights.header.titleHighlighted}
      description={t.flights.header.description}
    />

    <div class="Flights__scrollContainer">
      {
        t.flights.items.map((flight, i) => (
          <FlightCard
            title={flight.title}
            description={flight.description}
            price={flight.price}
            duration={flight.duration}
            image={flightMedia[i]?.image}
            videoSrc={flightMedia[i]?.videoSrc}
          />
        ))
      }
    </div>

    <div class="Flights__controls">
      <button
        class="Flights__controlButton Flights__controlButton--prev"
        type="button"
        aria-label="Previous flights"
      >
        <ArrowIcon />
      </button>
      <div class="Flights__pagination"></div>
      <button
        class="Flights__controlButton Flights__controlButton--next"
        type="button"
        aria-label="Next flights"
      >
        <ArrowIcon />
      </button>
    </div>
  </div>

</section>

<script>
  // Wait for the DOM to load
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.querySelector(".Flights__scrollContainer");
    const pagination = document.querySelector(".Flights__pagination");
    const cards = container?.querySelectorAll(":scope > *");
    const prevBtn = document.querySelector(".Flights__controlButton--prev");
    const nextBtn = document.querySelector(".Flights__controlButton--next");

    if (!container || !pagination) return;
    if (!cards || cards.length === 0) return;

    const scrollContainer = container as HTMLElement;
    const cardList = Array.from(cards) as HTMLElement[];

    // Distance from the start of one card to the start of the next
    // (card width + gap). Falls back to the single card width.
    const getStride = () => {
      if (cardList.length < 2) {
        return cardList[0].getBoundingClientRect().width || 1;
      }
      return cardList[1].offsetLeft - cardList[0].offsetLeft || 1;
    };

    // How many cards are fully visible at once (responsive: 1 / 2 / 3).
    const getVisibleCount = () =>
      Math.max(1, Math.round(scrollContainer.clientWidth / getStride()));

    let visibleCount = getVisibleCount();
    let pageCount = Math.ceil(cardList.length / visibleCount);
    let activePage = 0;

    const updateActiveDot = () => {
      const dots = pagination.querySelectorAll(".Flights__dot");
      dots.forEach((dot, index) => {
        dot.classList.toggle("Flights__dot--active", index === activePage);
      });
    };

    const scrollToPage = (page: number) => {
      const clamped = Math.max(0, Math.min(page, pageCount - 1));
      activePage = clamped;
      const target = cardList[clamped * visibleCount];
      if (target) {
        scrollContainer.scrollTo({
          left: target.offsetLeft - scrollContainer.offsetLeft,
          behavior: "smooth",
        });
      }
      updateActiveDot();
    };

    // (Re)build the pagination dots — one per page.
    const buildDots = () => {
      pagination.innerHTML = "";
      for (let i = 0; i < pageCount; i++) {
        const dot = document.createElement("button");
        dot.classList.add("Flights__dot");
        dot.setAttribute("aria-label", `Go to page ${i + 1}`);
        dot.addEventListener("click", () => scrollToPage(i));
        pagination.appendChild(dot);
      }
      updateActiveDot();
    };

    // Recompute layout-dependent values (called on load and resize).
    const recompute = () => {
      visibleCount = getVisibleCount();
      pageCount = Math.ceil(cardList.length / visibleCount);
      activePage = Math.min(activePage, pageCount - 1);
      buildDots();
    };

    recompute();

    // Track the active page while scrolling.
    scrollContainer.addEventListener("scroll", () => {
      const maxScroll =
        scrollContainer.scrollWidth - scrollContainer.clientWidth;
      if (maxScroll > 0 && scrollContainer.scrollLeft >= maxScroll - 1) {
        activePage = pageCount - 1;
      } else {
        activePage = Math.min(
          pageCount - 1,
          Math.round(scrollContainer.scrollLeft / (getStride() * visibleCount)),
        );
      }
      updateActiveDot();
    });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(recompute, 150);
    });

    prevBtn?.addEventListener("click", () => {
      scrollToPage(activePage - 1);
    });

    nextBtn?.addEventListener("click", () => {
      scrollToPage(activePage + 1);
    });

    const prefersHover =
      window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    if (prefersHover) {
      document.querySelectorAll(".FlightCard").forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>(
          ".FlightCard__backgroundVideo",
        );
        if (!video) return;

        card.addEventListener("mouseenter", () => {
          void video.play().catch(() => {});
        });
        card.addEventListener("mouseleave", () => {
          video.pause();
          video.currentTime = 0;
        });
      });
    }
  });
</script>
