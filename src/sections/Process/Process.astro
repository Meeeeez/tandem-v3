---
import "./Process.scss";
import Header from "../../components/Header/Header.astro";
import FullscreenSlider from "../../components/FullscreenSlider/FullscreenSlider.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slideImages = [
  "/tandem-v3/img/1.jpg",
  "/tandem-v3/img/2.jpg",
  "/tandem-v3/img/3.jpg",
  "/tandem-v3/img/hero.webp",
  "/tandem-v3/img/2.jpg",
];

const slides = t.process.slides.map((slide, i) => ({
  title: slide.title,
  description: slide.description,
  imageAlt: slide.imageAlt,
  imageSrc: slideImages[i],
}));
---

<section class="Process" id="process">
  <FullscreenSlider slides={slides}>
    <Header
      slot="header"
      title={t.process.header.title}
      titleHighlighted={t.process.header.titleHighlighted}
      description={t.process.header.description}
      onPrimaryBackground
    />
  </FullscreenSlider>
</section>
