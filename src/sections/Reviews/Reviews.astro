---
import Header from "../../components/Header/Header.astro";
import "./Reviews.scss";

const reviews = [
  {
    rating: 5,
    quote:
      "Absolutely the highlight of our trip. Luca made us feel safe from the first second, and the views over the Geisler peaks were unreal.",
    name: "Sarah K.",
    origin: "Berlin, DE",
  },
  {
    rating: 5,
    quote:
      "First time flying and now I want to do it every weekend. Smooth take-off, gentle landing, great photos at the end.",
    name: "Marco D.",
    origin: "Milan, IT",
  },
  {
    rating: 5,
    quote:
      "Booked the Thermal flight — 30 minutes felt like 5. Professional, friendly, and the location speaks for itself.",
    name: "James P.",
    origin: "London, UK",
  },
  {
    rating: 5,
    quote:
      "We gave this as a birthday gift and got tears of joy. Communication was perfect from the first message to landing.",
    name: "Anna & Tom",
    origin: "Vienna, AT",
  },
];
---

<section class="Reviews" id="reviews">
  <div class="container">
    <Header
      title="choose <br>your"
      titleHighlighted="adventure"
      description="If Bradford matched Core City averages across key metrics, <b>productivity would rise to £37.80 per hour</b>, the business base would grow to nearly 20,000, and the working‑age population would increase."
      onBackground="white"
    />
  </div>
</section>
