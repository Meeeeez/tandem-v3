---
import Header from "../../components/Header/Header.astro";
import ArrowIcon from "../../assets/icons/arrow.svg";
import ReviewCard from "../../components/ReviewCard/ReviewCard.astro";
import "./Reviews.scss";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const reviews = t.reviews.items;
---

<section class="Reviews" id="reviews">
  <div class="container">
    <Header
      title={t.reviews.header.title}
      titleHighlighted={t.reviews.header.titleHighlighted}
      description={t.reviews.header.description}
    />
    <div class="Reviews__highlight">
      <h4 class="Reviews__highlightText">{t.reviews.highlight.quote}</h4>
      <div class="Reviews__highlightBottomRow">
        <p class="Reviews__highlightName">{t.reviews.highlight.name}</p>
        <p class="Reviews__highlightDetails">{t.reviews.highlight.details}</p>
      </div>
    </div>

    <div class="Reviews__scrollContainer">
      {
        reviews.map((review) => (
          <ReviewCard
            rating={review.rating}
            quote={review.quote}
            name={review.name}
            flightType={review.flightType}
            flightDate={review.flightDate}
          />
        ))
      }
    </div>

    <div class="Reviews__controls">
      <button class="Reviews__controlButton Reviews__controlButton--prev" type="button">
        <ArrowIcon />
      </button>
      <div class="Reviews__pagination"></div>
      <button class="Reviews__controlButton Reviews__controlButton--next" type="button">
        <ArrowIcon />
      </button>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector("#reviews");
    const container = section?.querySelector(".Reviews__scrollContainer");
    const pagination = section?.querySelector(".Reviews__pagination");
    const cards = container?.querySelectorAll(":scope > *");
    const prevBtn = section?.querySelector(".Reviews__controlButton--prev");
    const nextBtn = section?.querySelector(".Reviews__controlButton--next");

    if (!container || !pagination) return;
    if (!cards || cards.length === 0) return;

    cards.forEach((_, index) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.classList.add("Reviews__dot");
      dot.setAttribute("aria-label", `Go to review ${index + 1}`);
      dot.addEventListener("click", () => scrollToIndex(index));
      pagination.appendChild(dot);
    });

    const dots = pagination.querySelectorAll(".Reviews__dot");
    let activeIndex = 0;

    const scrollToIndex = (index: number) => {
      const clamped = Math.max(0, Math.min(index, cards.length - 1));
      activeIndex = clamped;
      cards[clamped]?.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
        inline: "start",
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter(
          (e) => e.isIntersecting && e.intersectionRatio >= 0.5,
        );
        if (!visible.length) return;

        const rootLeft = container.getBoundingClientRect().left;
        visible.sort(
          (a, b) =>
            a.target.getBoundingClientRect().left -
            b.target.getBoundingClientRect().left,
        );
        const primary =
          visible.find(
            (e) => e.target.getBoundingClientRect().left >= rootLeft - 1,
          ) ?? visible[0];

        activeIndex = Array.from(cards ?? []).indexOf(primary.target);
        dots.forEach((dot, index) => {
          dot.classList.toggle(
            "Reviews__dot--active",
            index === activeIndex,
          );
        });
      },
      {
        root: container,
        threshold: [0, 0.25, 0.5, 0.75, 1],
      },
    );

    cards.forEach((card) => observer.observe(card));

    prevBtn?.addEventListener("click", () => {
      scrollToIndex(activeIndex - 1);
    });

    nextBtn?.addEventListener("click", () => {
      scrollToIndex(activeIndex + 1);
    });
  });
</script>