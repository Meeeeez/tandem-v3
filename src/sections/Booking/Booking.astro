---
import "./Booking.scss";
import BookingSteps from "../../components/BookingSteps/BookingSteps.astro";
import BookingStep from "../../components/BookingStep/BookingStep.astro";
import WhatsappIcon from "../../components/WhatsappIcon/WhatsappIcon.astro";
import FormField from "../../components/FormField/FormField.astro";
import ChoiceCard from "../../components/ChoiceCard/ChoiceCard.astro";
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const s = t.booking.steps;
const homeHref = localizedPath(lang, "home");
---

<div class="Booking">
  <div class="Booking__progress" aria-hidden="true">
    <span class="Booking__progressFill" data-progress-fill></span>
  </div>

  <aside class="Booking__aside">
    <div class="Booking__media"></div>

    <a class="Booking__logo" href={homeHref}>
      <span class="Booking__logoLine">{t.booking.logoLine1}</span>
      <span class="Booking__logoLine Booking__logoLine--accent">{t.booking.logoLine2}</span>
    </a>

    <p class="Booking__caption">{t.booking.caption}</p>
  </aside>

  <div class="Booking__main">
    <BookingSteps>
      <BookingStep>
        <span slot="title" set:html={s.nameTitle}></span>
        <FormField
          id="bk-name"
          name="firstName"
          label={s.nameLabel}
          placeholder={s.namePlaceholder}
          required
          autocomplete="given-name"
        />
      </BookingStep>

      <BookingStep
        image="/tandem-v3/img/2.jpg"
      >
        <span slot="title" set:html={s.contactTitle}></span>
        <div class="BookingSteps__choices" data-contact-choices>
          <ChoiceCard
            id="bk-contact-whatsapp"
            name="contactMethod"
            value="whatsapp"
            title={s.whatsappTitle}
            description={s.whatsappDescription}
          >
            <WhatsappIcon slot="icon" />
          </ChoiceCard>
          <ChoiceCard
            id="bk-contact-email"
            name="contactMethod"
            value="email"
            title={s.emailTitle}
            description={s.emailDescription}
          >
            <svg
              slot="icon"
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </ChoiceCard>
        </div>
      </BookingStep>

      <BookingStep contactDetails>
        <span slot="title" data-contact-title="email" hidden set:html={s.emailFieldTitle}></span>
        <span slot="title" data-contact-title="whatsapp" hidden set:html={s.whatsappFieldTitle}></span>
        <div data-contact-field="email" hidden>
          <FormField
            id="bk-email"
            name="email"
            type="email"
            label={s.emailLabel}
            placeholder={s.emailPlaceholder}
            autocomplete="email"
          />
        </div>
        <div data-contact-field="whatsapp" hidden>
          <FormField
            id="bk-whatsapp"
            name="whatsapp"
            type="tel"
            label={s.whatsappLabel}
            placeholder={s.whatsappPlaceholder}
            inputmode="tel"
          />
        </div>
      </BookingStep>

      <BookingStep
        image="/tandem-v3/img/3.jpg"
      >
        <span slot="title" set:html={s.datesTitle}></span>
        <div class="BookingSteps__row">
          <FormField
            id="bk-date-from"
            name="dateFrom"
            type="date"
            label={s.dateFromLabel}
            required
          />
          <FormField
            id="bk-date-to"
            name="dateTo"
            type="date"
            label={s.dateToLabel}
            required
          />
        </div>
      </BookingStep>

      <BookingStep>
        <span slot="title" set:html={s.passengersTitle}></span>
        <div class="BookingSteps__numberChoices" data-passenger-choices>
          <label class="BookingSteps__numberChoice" for="bk-passengers-1">
            <input
              class="BookingSteps__numberChoiceInput"
              id="bk-passengers-1"
              type="radio"
              name="passengers"
              value="1"
            />
            <span class="BookingSteps__numberChoiceLabel">1</span>
          </label>
          <label class="BookingSteps__numberChoice" for="bk-passengers-2">
            <input
              class="BookingSteps__numberChoiceInput"
              id="bk-passengers-2"
              type="radio"
              name="passengers"
              value="2"
            />
            <span class="BookingSteps__numberChoiceLabel">2</span>
          </label>
          <label class="BookingSteps__numberChoice" for="bk-passengers-3">
            <input
              class="BookingSteps__numberChoiceInput"
              id="bk-passengers-3"
              type="radio"
              name="passengers"
              value="3"
            />
            <span class="BookingSteps__numberChoiceLabel">3</span>
          </label>
          <label class="BookingSteps__numberChoice" for="bk-passengers-4plus">
            <input
              class="BookingSteps__numberChoiceInput"
              id="bk-passengers-4plus"
              type="radio"
              name="passengers"
              value="4+"
            />
            <span class="BookingSteps__numberChoiceLabel">4+</span>
          </label>
        </div>
      </BookingStep>

      <BookingStep
        image="/tandem-v3/img/stolen.webp"
        isLast
        description={s.summaryDescription}
        hintMuted={s.summaryHint}
      >
        <span slot="title" set:html={s.summaryTitle}></span>
        <dl class="BookingSteps__summary">
          <div class="BookingSteps__summaryRow">
            <dt>{s.summaryName}</dt>
            <dd data-summary="name">&mdash;</dd>
          </div>
          <div class="BookingSteps__summaryRow">
            <dt data-summary-label="contact">{s.summaryContact}</dt>
            <dd data-summary="contact">&mdash;</dd>
          </div>
          <div class="BookingSteps__summaryRow">
            <dt>{s.summaryDates}</dt>
            <dd data-summary="dates">&mdash;</dd>
          </div>
          <div class="BookingSteps__summaryRow">
            <dt>{s.summaryPassengers}</dt>
            <dd data-summary="passengers">&mdash;</dd>
          </div>
        </dl>
      </BookingStep>
    </BookingSteps>
  </div>
</div>
