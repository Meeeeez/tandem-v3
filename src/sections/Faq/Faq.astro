---
import './Faq.scss';
import Header from '../../components/Header/Header.astro';
const items = [
  {
    q: "Is it safe?",
    a: "Tandem paragliding has one of the lowest incident rates in adventure sports. Every pilot here holds a current FIVL T2 license, all wings are EN-certified and re-packed every 100 flights, and we only fly in good conditions. If the weather isn't right, we don't fly — full stop.",
  },
  {
    q: "Do I need experience?",
    a: "None. Most of our passengers have never been in a paraglider before. Your pilot handles everything — the launch, the steering, the landing. You just take a few running steps and then sit back.",
  },
  {
    q: "Weight & age limits?",
    a: "We fly passengers from 25 kg to 110 kg. Minimum age is 5 with a parent's consent — there's no upper age limit; our oldest passenger was 84. Let us know about any mobility considerations when you book.",
  },
  {
    q: "What if the weather's bad?",
    a: "We confirm a 24h weather window the evening before your flight. If it's no-go on the day, we reschedule — or refund in full if you can't make another date. No deposit lost, no questions.",
  },
  {
    q: "What should I wear?",
    a: "Comfortable trousers, closed shoes (trainers are perfect — no sandals), a light jacket. It's 5–10°C cooler at launch than in the valley, even in summer. Sunglasses are useful. We provide the helmet and harness.",
  },
  {
    q: "Will I get photos and video?",
    a: "Yes. Your pilot carries a GoPro on a long pole and films the whole flight. Photos and a short edit land on your phone via WhatsApp within an hour of landing — included with Thermal and Adventure flights, +20 € on Glide.",
  },
];
---

<section class="Faq" id="faq">
  <div class="container">
    <div class="Faq__layout">
      <div class="Faq__header">
        <Header
          title="Questions you <br>"
          titleHighlighted="might have"
          description="Six questions we hear before almost every booking. If yours isn’t here, WhatsApp us — replies are usually within the hour."
        />
      </div>

      <div class="Faq__list">
      {items.map((item, i) => (
        <details class="Faq__item" name="faq" open={i === 0}>
          <summary class="Faq__question">
            <span class="Faq__questionText">{item.q}</span>
            <span class="Faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="Faq__answer">
            <p class="Faq__answerText">{item.a}</p>
          </div>
        </details>
      ))}
      </div>
    </div>
  </div>
</section>