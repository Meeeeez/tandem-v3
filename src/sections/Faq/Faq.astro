---
import './Faq.scss';
import Header from '../../components/Header/Header.astro';
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = t.faq.items;
---

<section class="Faq" id="faq">
  <div class="container">
    <div class="Faq__layout">
      <div class="Faq__header">
        <Header
          title={t.faq.header.title}
          titleHighlighted={t.faq.header.titleHighlighted}
          description={t.faq.header.description}
        />
      </div>

      <div class="Faq__list">
      {items.map((item, i) => (
        <details class="Faq__item" open={i === 0}>
          <summary class="Faq__question">
            <span class="Faq__questionText">{item.q}</span>
            <span class="Faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="Faq__answer">
            <p class="Faq__answerText">{item.a}</p>
          </div>
        </details>
      ))}
      </div>
    </div>
  </div>
</section>

<script>
  class FaqAccordion {
    el: HTMLDetailsElement;
    group: FaqAccordion[];
    summary: HTMLElement;
    content: HTMLElement;
    animation: Animation | null = null;
    isClosing = false;
    isExpanding = false;

    constructor(el: HTMLDetailsElement, group: FaqAccordion[]) {
      this.el = el;
      this.group = group;
      this.summary = el.querySelector('.Faq__question') as HTMLElement;
      this.content = el.querySelector('.Faq__answer') as HTMLElement;
      this.summary.addEventListener('click', (e) => this.onClick(e));
    }

    get duration() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 300;
    }

    onClick(e: Event) {
      e.preventDefault();
      this.el.style.overflow = 'hidden';
      if (this.isClosing || !this.el.open) {
        this.open();
      } else if (this.isExpanding || this.el.open) {
        this.shrink();
      }
    }

    open() {
      // Close any other open items in the group (animated).
      this.group.forEach((item) => {
        if (item !== this && (item.el.open || item.isExpanding)) {
          item.el.style.overflow = 'hidden';
          item.shrink();
        }
      });

      this.el.style.height = `${this.el.offsetHeight}px`;
      this.el.open = true;
      window.requestAnimationFrame(() => this.expand());
    }

    expand() {
      this.isExpanding = true;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight + this.content.offsetHeight}px`;

      if (this.animation) this.animation.cancel();

      this.animation = this.el.animate(
        { height: [startHeight, endHeight] },
        { duration: this.duration, easing: 'ease' }
      );
      this.animation.onfinish = () => this.onAnimationFinish(true);
      this.animation.oncancel = () => (this.isExpanding = false);
    }

    shrink() {
      this.isClosing = true;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight}px`;

      if (this.animation) this.animation.cancel();

      this.animation = this.el.animate(
        { height: [startHeight, endHeight] },
        { duration: this.duration, easing: 'ease' }
      );
      this.animation.onfinish = () => this.onAnimationFinish(false);
      this.animation.oncancel = () => (this.isClosing = false);
    }

    onAnimationFinish(open: boolean) {
      this.el.open = open;
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.el.style.height = '';
      this.el.style.overflow = '';
    }
  }

  const items = document.querySelectorAll<HTMLDetailsElement>('.Faq__item');
  const group: FaqAccordion[] = [];
  items.forEach((el) => group.push(new FaqAccordion(el, group)));
</script>