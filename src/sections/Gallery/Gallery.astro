---
import "./Gallery.scss";

// Images cycled twice so the marquee loop is seamless.
const images = [
  { src: "/img/1.jpg", alt: "Paragliding over the Dolomites" },
  { src: "/img/2.jpg", alt: "Pilot preparing for take-off" },
  { src: "/img/3.jpg", alt: "Take-off from the ridge" },
  { src: "/img/1.jpg", alt: "Soaring above the peaks" },
  { src: "/img/2.jpg", alt: "Meeting at the launch site" },
  { src: "/img/3.jpg", alt: "Running launch" },
];
---

<section class="Gallery" aria-label="Flight gallery">
  <div class="Gallery__track">
    {[...images, ...images].map((img) => (
      <figure class="Gallery__item">
        <img src={img.src} alt={img.alt} loading="lazy" />
      </figure>
    ))}
  </div>
</section>
