---
import "./FormField.scss";

type Props = {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "date" | "textarea";
  placeholder?: string;
  required?: boolean;
  value?: string;
  rows?: number;
  min?: string;
  inputmode?: "text" | "tel" | "email" | "numeric";
  autocomplete?: string;
  /** Enable intl-tel-input country code selector (tel inputs only). */
  intlTel?: boolean;
  /** ISO2 country code for intl-tel-input initial country. */
  initialCountry?: string;
  /** Locale used to pick a default country when initialCountry is omitted. */
  lang?: string;
};

const {
  id,
  name,
  label,
  type = "text",
  placeholder,
  required = false,
  value,
  rows = 4,
  min,
  inputmode,
  autocomplete,
  intlTel = false,
  initialCountry,
  lang,
} = Astro.props as Props;

const useIntlTel = intlTel && type === "tel";
---

<div class:list={["FormField", { "FormField--phone": useIntlTel }]}>
  <label class="FormField__label" for={id}>{label}</label>
  {
    type === "textarea" ? (
      <textarea
        class="FormField__control FormField__control--textarea"
        id={id}
        name={name}
        rows={rows}
        placeholder={placeholder}
        required={required}
      >{value}</textarea>
    ) : (
      <input
        class="FormField__control"
        id={id}
        name={name}
        type={type}
        placeholder={placeholder}
        required={required}
        value={value}
        min={min}
        inputmode={inputmode}
        autocomplete={autocomplete}
        data-intl-tel={useIntlTel ? "" : undefined}
        data-intl-tel-lang={useIntlTel ? lang : undefined}
        data-intl-tel-country={useIntlTel ? initialCountry : undefined}
      />
    )
  }
</div>

{
  useIntlTel && (
    <script>
      import { initIntlTelFields } from "./initIntlTel.ts";

      const init = () => initIntlTelFields();

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    </script>
  )
}
