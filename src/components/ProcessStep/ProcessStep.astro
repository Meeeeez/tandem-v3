---
import "./ProcessStep.scss";

type Props = {
  stepIndex: number;
  stepTotal: number;
  title: string;
  description: string;
  imageSrc: string;
  imageAlt?: string;
  overlayText?: string;
};

const { stepIndex, stepTotal, title, description, imageSrc, imageAlt, overlayText } = Astro.props as Props;

const indexLabel = String(stepIndex).padStart(2, "0");
const totalLabel = String(stepTotal).padStart(2, "0");
---

<article class="ProcessStep">
  <header class="ProcessStep__header">
    <p class="ProcessStep__stepLabel" aria-hidden="true">
      <span class="ProcessStep__stepBullet"></span>
      <span class="ProcessStep__stepIndex">{indexLabel}</span>
      <span class="ProcessStep__stepTotal">/ {totalLabel}</span>
    </p>
    <h4 class="ProcessStep__title">{title}</h4>
    <p class="ProcessStep__description">{description}</p>
  </header>

  <div class="ProcessStep__body">
    <div class="ProcessStep__media">
      <img class="ProcessStep__image" src={imageSrc} alt={imageAlt ?? ""} loading="lazy" />
      {overlayText && <div class="ProcessStep__overlay">{overlayText}</div>}
    </div>
  </div>
</article>

