---
import "./BookingSteps.scss";
import ArrowIcon from "../../assets/icons/arrow.svg";
import ChevronLeftIcon from "../../assets/icons/chevron-left.svg";
import TriangleAlertIcon from "../../assets/icons/triangle-alert.svg";
import linesImg from "../../assets/img/lines.png";
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const actions = t.booking.actions;
const done = t.booking.done;
const homeHref = localizedPath(lang, "home");

// Strings the client-side script needs; injected as JSON since the script
// itself is locale-agnostic at runtime.
const scriptI18n = {
  empty: t.booking.summaryDynamic.empty,
  email: t.booking.steps.emailTitle,
  whatsapp: t.booking.steps.whatsappTitle,
  passengers1: t.booking.summaryDynamic.passengers1,
  passengers2: t.booking.summaryDynamic.passengers2,
  passengers3: t.booking.summaryDynamic.passengers3,
  passengers4Plus: t.booking.summaryDynamic.passengers4Plus,
  dateLocale: t.booking.summaryDynamic.dateLocale,
  errors: t.booking.errors,
};
---

<div
  class="BookingSteps BookingSteps--first-step"
  data-booking-steps
  data-booking-i18n={JSON.stringify(scriptI18n)}
>
  <form class="BookingSteps__form" data-booking-form novalidate>
    <slot />

    <div class="BookingSteps__honeypot" aria-hidden="true">
      <label for="bk-website">Website</label>
      <input
        id="bk-website"
        name="honeypot"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="BookingSteps__nav">
      <button
        class="BookingSteps__navBtn BookingSteps__navBtn--prev"
        type="button"
        data-prev
        aria-label={actions.prevStep}
        disabled
      >
        <ChevronLeftIcon />
      </button>
      <button
        class="BookingSteps__navBtn BookingSteps__navBtn--next"
        type="button"
        data-next
        aria-label={actions.nextStep}
      >
        <ChevronLeftIcon />
      </button>
    </div>
  </form>

  <div class="BookingSteps__mobileNav">
    <div
      class="BookingSteps__error"
      data-booking-error-mobile
      hidden
      role="alert"
      aria-live="polite"
    >
      <TriangleAlertIcon class="BookingSteps__errorIcon" aria-hidden="true" />
      <span class="BookingSteps__errorText" data-booking-error-text></span>
    </div>
    <div class="BookingSteps__mobileNavRow">
      <button
        class="BookingSteps__mobileBack"
        type="button"
        data-prev
        aria-label={actions.prevStep}
        disabled
      >
        <ChevronLeftIcon />
      </button>
      <button
        class="BookingSteps__ok BookingSteps__mobileOk animate-fill"
        type="button"
        data-next
      >
        <span class="BookingSteps__okLabel">{actions.ok}</span>
      </button>
    </div>
  </div>

  <div class="BookingSteps__burst" data-booking-burst hidden aria-hidden="true"></div>

  <div class="BookingSteps__done" data-booking-done>
    <img
      class="BookingSteps__doneBg"
      src={linesImg.src}
      alt=""
      aria-hidden="true"
    />
    <div class="BookingSteps__doneInner">
      <div class="BookingSteps__doneMark" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="34"
          height="34"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="4 12 10 18 20 6"></polyline>
        </svg>
      </div>
      <h2 class="BookingStep__title">{done.title}</h2>
      <p class="BookingStep__desc">{done.text}</p>
      <a class="BookingSteps__doneHome animate-fill" href={homeHref}>
        {done.backHome}
      </a>
    </div>
  </div>
</div>

<script>
  import {
    getIntlTelInstance,
    initIntlTelFields,
  } from "../FormField/initIntlTel.ts";

  const initBookingSteps = () => {
    const stepsRoot = document.querySelector<HTMLElement>("[data-booking-steps]");
    const booking = stepsRoot?.closest<HTMLElement>(".Booking");

    if (!stepsRoot || !booking) return;

    initIntlTelFields(stepsRoot);

    type BookingI18n = {
      empty: string;
      email: string;
      whatsapp: string;
      passengers1: string;
      passengers2: string;
      passengers3: string;
      passengers4Plus: string;
      dateLocale: string;
      errors: {
        required: string;
        email: string;
        phone: string;
        contactMethod: string;
        passengers: string;
        dateRange: string;
        datePast: string;
        submit: string;
      };
    };
    const i18n: BookingI18n = JSON.parse(
      stepsRoot.dataset.bookingI18n ?? "{}",
    );

    const todayIso = () => {
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, "0");
      const d = String(now.getDate()).padStart(2, "0");
      return `${y}-${m}-${d}`;
    };

    const dateInputs = Array.from(
      stepsRoot.querySelectorAll<HTMLInputElement>("input[type='date']"),
    );
    const minDate = todayIso();
    dateInputs.forEach((input) => {
      input.min = minDate;
    });

    const form = stepsRoot.querySelector<HTMLFormElement>("[data-booking-form]");
    const steps = Array.from(
      stepsRoot.querySelectorAll<HTMLElement>(".BookingStep"),
    );
    const stepImages = steps.map((step) =>
      step.querySelector<HTMLImageElement>("[data-step-image]"),
    );
    const media = booking.querySelector<HTMLElement>(".Booking__media");
    const progressFill = booking.querySelector<HTMLElement>(
      "[data-progress-fill]",
    );
    const prevBtns = Array.from(
      stepsRoot.querySelectorAll<HTMLButtonElement>("[data-prev]"),
    );
    const contactRadios = Array.from(
      stepsRoot.querySelectorAll<HTMLInputElement>("input[name='contactMethod']"),
    );
    const passengerRadios = Array.from(
      stepsRoot.querySelectorAll<HTMLInputElement>("input[name='passengers']"),
    );
    const emailWrap = stepsRoot.querySelector<HTMLElement>(
      "[data-contact-field='email']",
    );
    const waWrap = stepsRoot.querySelector<HTMLElement>(
      "[data-contact-field='whatsapp']",
    );
    const contactTitles = Array.from(
      stepsRoot.querySelectorAll<HTMLElement>("[data-contact-title]"),
    );

    const total = steps.length;
    let current = 0;
    const STEP_PARAM = "step";

    const getStepFromUrl = () => {
      const raw = new URLSearchParams(window.location.search).get(STEP_PARAM);
      if (!raw) return 0;
      const n = Number.parseInt(raw, 10);
      if (Number.isNaN(n) || n < 1) return 0;
      return Math.min(n - 1, total - 1);
    };

    const buildStepUrl = (index: number) => {
      const url = new URL(window.location.href);
      if (index <= 0) {
        url.searchParams.delete(STEP_PARAM);
      } else {
        url.searchParams.set(STEP_PARAM, String(index + 1));
      }
      return `${url.pathname}${url.search}${url.hash}`;
    };

    const syncStepUrl = (
      index: number,
      mode: "push" | "replace",
    ) => {
      const url = buildStepUrl(index);
      const state = { step: index };
      if (mode === "push") {
        history.pushState(state, "", url);
      } else {
        history.replaceState(state, "", url);
      }
    };

    const value = (name: string) => {
      const el = form?.querySelector<HTMLInputElement | HTMLTextAreaElement>(
        `[name='${name}']`,
      );
      if (!el) return "";

      if (
        el instanceof HTMLInputElement &&
        el.hasAttribute("data-intl-tel")
      ) {
        const iti = getIntlTelInstance(el);
        const full = iti?.getNumber()?.trim();
        if (full) return full;
      }

      return el.value.trim();
    };

    const setSummary = (key: string, text: string) => {
      stepsRoot
        .querySelectorAll<HTMLElement>(`[data-summary='${key}']`)
        .forEach((el) => (el.textContent = text));
    };

    const formatDate = (v: string) => {
      if (!v) return "";
      const d = new Date(`${v}T00:00:00`);
      if (Number.isNaN(d.getTime())) return v;
      return d.toLocaleDateString(i18n.dateLocale, {
        day: "numeric",
        month: "short",
      });
    };

    const updateSummary = () => {
      const name = value("firstName");
      const method =
        contactRadios.find((r) => r.checked)?.value ?? "";
      const contact =
        method === "email"
          ? value("email")
          : method === "whatsapp"
            ? value("whatsapp")
            : "";
      const from = formatDate(value("dateFrom"));
      const to = formatDate(value("dateTo"));
      const passengers = passengerRadios.find((r) => r.checked)?.value ?? "";

      stepsRoot
        .querySelectorAll<HTMLElement>("[data-summary='nameTitle']")
        .forEach((el) => (el.textContent = name));
      stepsRoot
        .querySelectorAll<HTMLElement>("[data-summary='nameClause']")
        .forEach((el) => (el.hidden = !name));

      const contactLabel = stepsRoot.querySelector<HTMLElement>(
        "[data-summary-label='contact']",
      );
      if (contactLabel)
        contactLabel.textContent = method === "email" ? i18n.email : i18n.whatsapp;

      setSummary("name", name || i18n.empty);
      setSummary("contact", contact || i18n.empty);
      setSummary(
        "dates",
        from && to ? `${from} → ${to}` : from || to || i18n.empty,
      );
      setSummary(
        "passengers",
        passengers === "1"
          ? i18n.passengers1
          : passengers === "2"
            ? i18n.passengers2
            : passengers === "3"
              ? i18n.passengers3
              : passengers === "4+"
                ? i18n.passengers4Plus
                : i18n.empty,
      );
    };

    const applyContactMethod = (focus = false) => {
      const selected = contactRadios.find((r) => r.checked);
      const emailInput =
        emailWrap?.querySelector<HTMLInputElement>(".FormField__control");
      const waInput =
        waWrap?.querySelector<HTMLInputElement>(".FormField__control");

      if (!selected) {
        if (emailWrap) emailWrap.hidden = true;
        if (waWrap) waWrap.hidden = true;
        if (emailInput) emailInput.required = false;
        if (waInput) waInput.required = false;
        contactTitles.forEach((title) => {
          title.hidden = true;
        });
        return;
      }

      const isEmail = selected.value === "email";

      if (emailWrap) emailWrap.hidden = !isEmail;
      if (waWrap) waWrap.hidden = isEmail;
      if (emailInput) emailInput.required = isEmail;
      if (waInput) waInput.required = !isEmail;

      contactTitles.forEach((title) => {
        title.hidden = title.dataset.contactTitle !== selected.value;
      });

      if (focus) {
        window.setTimeout(() => {
          const activeInput = isEmail ? emailInput : waInput;
          activeInput?.focus();
        }, 60);
      }
    };

    const clearStepInvalid = (step: HTMLElement) => {
      step
        .querySelectorAll<HTMLElement>(".is-invalid")
        .forEach((el) => el.classList.remove("is-invalid"));
    };

    const clearError = () => {
      steps.forEach((step) => {
        clearStepInvalid(step);
        const alert = step.querySelector<HTMLElement>("[data-booking-error]");
        if (!alert) return;
        alert.hidden = true;
        const text = alert.querySelector<HTMLElement>("[data-booking-error-text]");
        if (text) text.textContent = "";
      });

      const mobileAlert = stepsRoot.querySelector<HTMLElement>(
        "[data-booking-error-mobile]",
      );
      if (mobileAlert) {
        mobileAlert.hidden = true;
        const text = mobileAlert.querySelector<HTMLElement>(
          "[data-booking-error-text]",
        );
        if (text) text.textContent = "";
      }

      stepsRoot.classList.remove("BookingSteps--has-error");
    };

    const showError = (
      stepIndex: number,
      message: string,
      el?: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null,
    ) => {
      clearError();

      const step = steps[stepIndex];
      const desktopAlert = step?.querySelector<HTMLElement>("[data-booking-error]");
      const mobileAlert = stepsRoot.querySelector<HTMLElement>(
        "[data-booking-error-mobile]",
      );

      [desktopAlert, mobileAlert].forEach((alert) => {
        if (!alert) return;
        const text = alert.querySelector<HTMLElement>("[data-booking-error-text]");
        if (text) text.textContent = message;
        alert.hidden = false;
      });

      stepsRoot.classList.add("BookingSteps--has-error");

      if (el) {
        el.classList.add("is-invalid");
        el.focus({ preventScroll: true });
      }
    };

    const messageForControl = (
      el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
      custom?: string,
    ) => {
      if (custom) return custom;
      if (el.validity.valueMissing) return i18n.errors.required;
      if (el.validity.typeMismatch && el.type === "email")
        return i18n.errors.email;
      if (el.validity.rangeUnderflow && el.type === "date")
        return i18n.errors.datePast;
      return el.validationMessage || i18n.errors.required;
    };

    const validateStep = (index: number, report = true) => {
      const step = steps[index];

      const fail = (
        el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null,
        message?: string,
      ) => {
        if (report) {
          const msg = el
            ? messageForControl(el, message)
            : (message ?? i18n.errors.required);
          showError(index, msg, el);
        }
        return false;
      };

      if (step.querySelector("[data-contact-choices]")) {
        if (!contactRadios.some((r) => r.checked)) {
          return fail(
            contactRadios[0] ?? null,
            i18n.errors.contactMethod,
          );
        }
        if (report) clearError();
        return true;
      }

      if (step.querySelector("[data-passenger-choices]")) {
        if (!passengerRadios.some((r) => r.checked)) {
          return fail(
            passengerRadios[0] ?? null,
            i18n.errors.passengers,
          );
        }
        if (report) clearError();
        return true;
      }

      if (step.hasAttribute("data-contact-details")) {
        const selected = contactRadios.find((r) => r.checked);
        if (!selected) return false;

        const isEmail = selected.value === "email";
        const input = isEmail
          ? emailWrap?.querySelector<HTMLInputElement>(".FormField__control")
          : waWrap?.querySelector<HTMLInputElement>(".FormField__control");

        if (!input) return false;

        input.setCustomValidity("");
        if (!input.checkValidity()) return fail(input);

        if (!isEmail && input.hasAttribute("data-intl-tel")) {
          const iti = getIntlTelInstance(input);
          if (iti && iti.isValidNumber() === false) {
            return fail(input, i18n.errors.phone);
          }
        }

        if (report) clearError();
        return true;
      }

      const controls = Array.from(
        step.querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >("input, textarea, select"),
      ).filter((el) => !el.closest("[hidden]"));

      for (const el of controls) {
        el.setCustomValidity("");
        if (!el.checkValidity()) return fail(el);
      }

      const from = step.querySelector<HTMLInputElement>("[name='dateFrom']");
      const to = step.querySelector<HTMLInputElement>("[name='dateTo']");
      const today = todayIso();
      if (from?.value && from.value < today) {
        return fail(from, i18n.errors.datePast);
      }
      if (to?.value && to.value < today) {
        return fail(to, i18n.errors.datePast);
      }
      if (from && to && from.value && to.value && to.value < from.value) {
        return fail(to, i18n.errors.dateRange);
      }

      if (report) clearError();
      return true;
    };

    const getMaxReachableStep = () => {
      for (let i = 0; i < total; i += 1) {
        if (!validateStep(i, false)) return i;
      }
      return total - 1;
    };

    const resolveStep = (requested: number, fromIndex: number) => {
      const bounded = Math.max(0, Math.min(requested, total - 1));
      if (bounded <= fromIndex) return bounded;
      return Math.min(bounded, getMaxReachableStep());
    };

    const focusFirstControl = (step: HTMLElement) => {
      const control = Array.from(
        step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input:not([type='radio']), textarea",
        ),
      ).find((el) => !el.closest("[hidden]"));
      window.setTimeout(() => control?.focus(), 60);
    };

    const STAGGER_MS = 60;
    const CONTACT_CHOICE_ADVANCE_MS = 150;
    const ANIMATE_FORWARD = "BookingStep__animate--forward";
    const ANIMATE_BACK = "BookingStep__animate--back";
    const MOBILE_MQ = window.matchMedia("(max-width: 767px)");
    let contactAdvanceTimer: number | null = null;

    const clearContactAdvance = () => {
      if (contactAdvanceTimer === null) return;
      window.clearTimeout(contactAdvanceTimer);
      contactAdvanceTimer = null;
    };

    const scheduleChoiceAdvance = (choicesSelector: string) => {
      clearContactAdvance();
      contactAdvanceTimer = window.setTimeout(() => {
        contactAdvanceTimer = null;
        if (!steps[current].querySelector(choicesSelector)) return;
        if (!validateStep(current)) return;
        setStep(current + 1, true, "forward", "push");
      }, CONTACT_CHOICE_ADVANCE_MS);
    };

    const getStepBlocks = (step: HTMLElement) => {
      const blocks: HTMLElement[] = [];
      const title = step.querySelector<HTMLElement>(".BookingStep__title");
      const desc = step.querySelector<HTMLElement>(".BookingStep__desc");
      const content = step.querySelector<HTMLElement>(".BookingStep__content");
      const actions = step.querySelector<HTMLElement>(".BookingStep__actions");

      if (title) blocks.push(title);
      if (desc && !desc.hidden) blocks.push(desc);
      if (content) {
        Array.from(content.children).forEach((child) => {
          const el = child as HTMLElement;
          if (el.hidden) return;
          blocks.push(el);
        });
      }
      if (actions) blocks.push(actions);

      return blocks;
    };

    const clearStepAnimation = (step: HTMLElement) => {
      step.classList.remove(ANIMATE_FORWARD, ANIMATE_BACK);
      step.style.animationDelay = "";
      getStepBlocks(step).forEach((block) => {
        block.classList.remove(ANIMATE_FORWARD, ANIMATE_BACK);
        block.style.animationDelay = "";
      });
    };

    const animateStep = (step: HTMLElement, direction: "forward" | "back") => {
      const animClass = direction === "forward" ? ANIMATE_FORWARD : ANIMATE_BACK;

      clearStepAnimation(step);

      if (MOBILE_MQ.matches) {
        void step.offsetWidth;
        step.classList.add(animClass);
        return;
      }

      getStepBlocks(step).forEach((block, i) => {
        block.style.animationDelay = `${i * STAGGER_MS}ms`;
        void block.offsetWidth;
        block.classList.add(animClass);
      });
    };

    const mountStepImages = () => {
      if (!media) return;
      let first = true;
      stepImages.forEach((img) => {
        if (!img) return;
        if (first) {
          img.loading = "eager";
          first = false;
        }
        media.appendChild(img);
      });
    };

    const updateStepImage = () => {
      stepImages.forEach((img) => img?.classList.remove("is-active"));
      stepImages[current]?.classList.add("is-active");
      booking.classList.toggle(
        "Booking--has-step-image",
        !!stepImages[current],
      );
    };

    const setStep = (
      index: number,
      focus = true,
      direction?: "forward" | "back",
      syncHistory: "push" | "replace" | "none" = "none",
    ) => {
      clearContactAdvance();
      clearError();
      const prev = current;
      const requested = Math.max(0, Math.min(index, total - 1));
      const next = resolveStep(requested, prev);
      const dir =
        direction ??
        (next > prev ? "forward" : next < prev ? "back" : "forward");

      const blocked = requested > next;
      if (blocked && focus) validateStep(next, true);

      current = next;

      steps.forEach((s, i) => s.classList.toggle("is-active", i === current));
      updateStepImage();

      if (progressFill)
        progressFill.style.width = `${((current + 1) / total) * 100}%`;
      prevBtns.forEach((btn) =>
        btn.toggleAttribute("disabled", current === 0),
      );
      stepsRoot.classList.toggle("BookingSteps--first-step", current === 0);

      applyContactMethod(
        steps[current].hasAttribute("data-contact-details") && focus,
      );
      animateStep(steps[current], dir);

      if (current === total - 1) updateSummary();
      if (focus && !blocked) focusFirstControl(steps[current]);

      if (syncHistory !== "none") {
        syncStepUrl(current, blocked ? "replace" : syncHistory);
      } else if (blocked) {
        syncStepUrl(current, "replace");
      }
    };

    stepsRoot.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;

      if (target.closest("[data-next]")) {
        event.preventDefault();
        if (current < total - 1) {
          if (validateStep(current)) setStep(current + 1, true, "forward", "push");
        } else {
          form?.requestSubmit();
        }
        return;
      }

      if (target.closest("[data-prev]")) {
        event.preventDefault();
        if (current > 0) history.back();
      }
    });

    form?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return;
      const target = event.target as HTMLElement;
      if (target.tagName === "TEXTAREA") return;

      event.preventDefault();
      if (current < total - 1) {
        if (validateStep(current)) setStep(current + 1, true, "forward", "push");
      } else {
        form.requestSubmit();
      }
    });

    contactRadios.forEach((radio) =>
      radio.addEventListener("change", () => {
        clearError();
        applyContactMethod();
        if (!steps[current].querySelector("[data-contact-choices]")) return;
        scheduleChoiceAdvance("[data-contact-choices]");
      }),
    );

    passengerRadios.forEach((radio) =>
      radio.addEventListener("change", () => {
        clearError();
        if (!steps[current].querySelector("[data-passenger-choices]")) return;
        scheduleChoiceAdvance("[data-passenger-choices]");
      }),
    );

    form?.addEventListener("input", () => {
      if (stepsRoot.classList.contains("BookingSteps--has-error")) clearError();
    });

    form?.addEventListener("change", () => {
      if (stepsRoot.classList.contains("BookingSteps--has-error")) clearError();
    });

    const SUBMIT_MIN_MS = 700;
    const BURST_MS = 850;

    const burst = stepsRoot.querySelector<HTMLElement>("[data-booking-burst]");

    const getSubmitBtns = () => {
      const btns: HTMLButtonElement[] = [];
      const desktop = stepsRoot.querySelector<HTMLButtonElement>(
        ".BookingStep.is-active .BookingStep__ok[type='submit']",
      );
      const mobile = stepsRoot.querySelector<HTMLButtonElement>(
        ".BookingSteps__mobileOk",
      );
      if (desktop) btns.push(desktop);
      if (mobile) btns.push(mobile);
      return btns;
    };

    const setSubmitLoading = (loading: boolean) => {
      const btns = getSubmitBtns().filter((btn) => btn.offsetHeight > 0);

      if (loading) {
        btns.forEach((btn) => {
          const height = btn.offsetHeight;
          const width = btn.offsetWidth;

          btn.style.setProperty("--booking-submit-size", `${height}px`);
          btn.style.width = `${width}px`;
          btn.style.height = `${height}px`;
          btn.style.minWidth = `${width}px`;
          btn.style.maxWidth = `${width}px`;
          btn.style.flex = `0 0 ${width}px`;

          btn.classList.add("is-loading");
          btn.toggleAttribute("disabled", true);
          btn.setAttribute("aria-busy", "true");
        });

        stepsRoot.classList.add("BookingSteps--submitting");

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            btns.forEach((btn) => {
              const size = btn.style.getPropertyValue("--booking-submit-size");
              btn.style.width = size;
              btn.style.minWidth = size;
              btn.style.maxWidth = size;
              btn.style.flex = `0 0 ${size}`;
            });
          });
        });

        return;
      }

      stepsRoot.classList.remove("BookingSteps--submitting");
      btns.forEach((btn) => {
        btn.classList.remove("is-loading");
        btn.toggleAttribute("disabled", false);
        btn.setAttribute("aria-busy", "false");
        btn.style.removeProperty("width");
        btn.style.removeProperty("height");
        btn.style.removeProperty("min-width");
        btn.style.removeProperty("max-width");
        btn.style.removeProperty("flex");
        btn.style.removeProperty("--booking-submit-size");
      });
    };

    const playSuccessBurst = () =>
      new Promise<void>((resolve) => {
        const btn = getSubmitBtns().find(
          (b) => b.offsetHeight > 0 && b.classList.contains("is-loading"),
        );

        const finish = () => {
          stepsRoot.classList.remove("BookingSteps--bursting");
          stepsRoot.classList.add("BookingSteps--done");
          booking?.classList.add("Booking--done");
          resolve();
        };

        if (!burst || !btn) {
          finish();
          return;
        }

        const rect = btn.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const diameter = Math.max(rect.width, rect.height);
        const radius = diameter / 2;
        const maxDist = Math.max(
          Math.hypot(cx, cy),
          Math.hypot(window.innerWidth - cx, cy),
          Math.hypot(cx, window.innerHeight - cy),
          Math.hypot(window.innerWidth - cx, window.innerHeight - cy),
        );
        const scale = maxDist / radius + 0.05;

        burst.style.width = `${diameter}px`;
        burst.style.height = `${diameter}px`;
        burst.style.left = `${cx}px`;
        burst.style.top = `${cy}px`;
        burst.style.setProperty("--burst-scale", String(scale));
        burst.hidden = false;
        burst.classList.remove("is-expanding");
        burst.classList.add("is-active");

        stepsRoot.classList.add("BookingSteps--bursting");

        let finished = false;
        const finishOnce = () => {
          if (finished) return;
          finished = true;
          finish();
        };

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          burst.style.transform = `translate(-50%, -50%) scale(${scale})`;
          finishOnce();
          return;
        }

        burst.addEventListener("animationend", finishOnce, { once: true });
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            burst.classList.add("is-expanding");
          });
        });

        window.setTimeout(finishOnce, BURST_MS + 100);
      });

    const BOOKING_ENDPOINT =
      "https://go783vbk7k.execute-api.eu-central-1.amazonaws.com/default/AirAdventureBooking";

    const buildPayload = () => {
      const method = contactRadios.find((r) => r.checked)?.value ?? "";
      const passengersRaw =
        passengerRadios.find((r) => r.checked)?.value ?? "";
      const passengers =
        passengersRaw === "4+" ? 4 : Number(passengersRaw);

      return {
        firstName: value("firstName"),
        contactMethod: method,
        email: method === "email" ? value("email") : "",
        whatsapp: method === "whatsapp" ? value("whatsapp") : "",
        dateFrom: value("dateFrom"),
        dateTo: value("dateTo"),
        passengers,
        honeypot: value("honeypot"),
      };
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      for (let i = 0; i < total; i += 1) {
        if (!validateStep(i, false)) {
          setStep(i, true, undefined, "replace");
          validateStep(i, true);
          return;
        }
      }

      setSubmitLoading(true);
      clearError();
      updateSummary();
      if (progressFill) progressFill.style.width = "100%";

      try {
        const [, res] = await Promise.all([
          new Promise<void>((resolve) =>
            window.setTimeout(resolve, SUBMIT_MIN_MS),
          ),
          fetch(BOOKING_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(buildPayload()),
          }),
        ]);

        if (!res.ok) throw new Error("submit failed");

        const data: { success?: boolean } = await res.json();
        if (!data.success) throw new Error("submit failed");

        await playSuccessBurst();
      } catch {
        setSubmitLoading(false);
        showError(total - 1, i18n.errors.submit);
      }
    });

    window.addEventListener("popstate", () => {
      const step = getStepFromUrl();
      if (step === current) return;
      setStep(
        step,
        false,
        step > current ? "forward" : "back",
        "none",
      );
    });

    applyContactMethod();
    mountStepImages();
    stepsRoot.classList.add("BookingSteps--initialized");
    setStep(getStepFromUrl(), false, undefined, "replace");
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBookingSteps);
  } else {
    initBookingSteps();
  }
</script>
