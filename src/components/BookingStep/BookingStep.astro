---
import "./BookingStep.scss";
import ArrowIcon from "../../assets/icons/arrow.svg";
import TriangleAlertIcon from "../../assets/icons/triangle-alert.svg";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

type Props = {
  contactDetails?: boolean;
  description?: string;
  image?: string;
  isLast?: boolean;
  hintMuted?: string;
};

const {
  contactDetails = false,
  description,
  image,
  isLast = false,
  hintMuted,
} = Astro.props as Props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const actions = t.booking.actions;
---

<section
  class:list={["BookingStep", { "BookingStep--no-desc": !description }]}
  data-contact-details={contactDetails || undefined}
>
  {
    image && (
      <img
        class="Booking__image"
        src={image}
        alt=""
        data-step-image
        loading="lazy"
      />
    )
  }
  <h5 class="BookingStep__title">
    <slot name="title" />
  </h5>
  {description && <p class="BookingStep__desc">{description}</p>}
  <div class="BookingStep__content">
    <slot />
  </div>
  <div class="BookingStep__actions">
    {
      isLast ? (
        <>
          <button class="BookingStep__ok animate-fill" type="submit">
            <span class="BookingStep__okLabel">{actions.sendRequest}</span>
            <ArrowIcon />
          </button>
          {hintMuted && (
            <span class="BookingStep__hint BookingStep__hint--muted">
              {hintMuted}
            </span>
          )}
        </>
      ) : (
        <>
          <button class="BookingStep__ok animate-fill" type="button" data-next>
            <span class="BookingStep__okLabel">{actions.ok}</span>
            <ArrowIcon />
          </button>
          <span class="BookingStep__hint">
            {actions.pressEnter} <kbd>Enter &crarr;</kbd>
          </span>
        </>
      )
    }
    <div
      class="BookingStep__error"
      data-booking-error
      hidden
      role="alert"
      aria-live="polite"
    >
      <TriangleAlertIcon class="BookingStep__errorIcon" aria-hidden="true" />
      <span class="BookingStep__errorText" data-booking-error-text></span>
    </div>
  </div>
</section>
