---
import './ContactForm.scss';
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const form = t.contact.form;
const flights = form.flightOptions;
---

<form class="ContactForm" data-contact-form novalidate>
  <div class="ContactForm__body">
    <p class="ContactForm__eyebrow">{form.eyebrow}</p>
    <h4 class="ContactForm__title">{form.title}</h4>

    <div class="ContactForm__field">
      <label class="ContactForm__label" for="cf-name">{form.nameLabel}</label>
      <input
        class="ContactForm__input"
        id="cf-name"
        name="name"
        type="text"
        required
        placeholder={form.namePlaceholder}
      />
    </div>

    <div class="ContactForm__row">
      <div class="ContactForm__field">
        <label class="ContactForm__label" for="cf-email">{form.emailLabel}</label>
        <input
          class="ContactForm__input"
          id="cf-email"
          name="email"
          type="email"
          required
          placeholder={form.emailPlaceholder}
        />
      </div>

      <div class="ContactForm__field">
        <label class="ContactForm__label" for="cf-flight">{form.flightLabel}</label>
        <select
          class="ContactForm__input ContactForm__input--select"
          id="cf-flight"
          name="flight"
          required
          defaultValue=""
        >
          <option value="" disabled selected>{form.flightPlaceholder}</option>
          {flights.map((f) => <option value={f}>{f}</option>)}
        </select>
      </div>
    </div>

    <div class="ContactForm__field">
      <label class="ContactForm__label" for="cf-msg">{form.messageLabel}</label>
      <textarea
        class="ContactForm__input ContactForm__input--textarea"
        id="cf-msg"
        name="message"
        rows="3"
        placeholder={form.messagePlaceholder}
      ></textarea>
    </div>

    <div class="ContactForm__submit">
      <button class="ContactForm__button" type="submit">
        <svg
          class="ContactForm__buttonIcon"
          width="16"
          height="17"
          viewBox="0 0 16 17"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M12.175 9.5H0V7.5H12.175L6.575 1.9L8 0.5L16 8.5L8 16.5L6.575 15.1L12.175 9.5Z"
            fill="currentColor"
          />
        </svg>
        {form.submit}
      </button>
      <p class="ContactForm__fineprint">{form.fineprint}</p>
    </div>
  </div>

  <div class="ContactForm__sent" data-contact-form-sent>
    <div class="ContactForm__sentMark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4 12 10 18 20 6" />
      </svg>
    </div>
    <h4 class="ContactForm__title">{form.sentTitle}</h4>
    <p class="ContactForm__sentText">{form.sentText}</p>
  </div>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");
  forms.forEach((form) => {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      form.classList.add("ContactForm--sent");
      // TODO: wire to real endpoint (fetch / formspree / mailto fallback)
    });
  });
</script>