---
import "./FlightCard.scss";

const {
  title,
  description,
  price,
  duration,
  maxAltitude,
  isMarked,
  popularLabel,
  bookLabel,
  image,
  imagePosition,
  videoSrc,
  href
} = Astro.props;

const facts = [maxAltitude, duration].filter(Boolean);
---

<div class="FlightCard">
  {isMarked && <div class="FlightCard__marker">{popularLabel}</div>}
  <div class="FlightCard__media" aria-hidden="true">
    <img
      class="FlightCard__backgroundImage"
      src={image}
      alt=""
      loading="lazy"
      decoding="async"
      style={imagePosition ? `object-position: ${imagePosition}` : undefined}
    />
    <video
      class="FlightCard__backgroundVideo"
      src={videoSrc}
      muted
      loop
      playsinline
      preload="metadata"></video>
  </div>

  <div class="FlightCard__body">
    <h2 class="FlightCard__title">{title}</h2>
    <p class="FlightCard__description">{description}</p>
    <div class="FlightCard__meta">
      {facts.length > 0 && (
        <p class="FlightCard__facts">
          {facts.map((fact, i) => (
            <>
              {i > 0 && <span class="FlightCard__factsSeparator" aria-hidden="true">·</span>}
              <span>{fact}</span>
            </>
          ))}
        </p>
      )}
      <div class="FlightCard__price">{price}</div>
    </div>
  </div>

  <button class="FlightCard__button animate-fill" type="button" data-href={href}>
    {bookLabel}
  </button>
</div>
