---
import './Header.scss'
const { title, titleHighlighted, description, onPrimaryBackground } = Astro.props;
---

<header class:list={["Header", { "Header--on-blue": !!onPrimaryBackground }]}>
    <h3 class="Header__title">
        <Fragment set:html={title} />
        <span class="Header__titleHighlight" set:html={titleHighlighted} />
    </h3>
    <p class="Header__description" set:html={description} />
</header>
