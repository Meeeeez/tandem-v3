---
import Layout from "../../layouts/Layout.astro";
import Booking from "../../sections/Booking/Booking.astro";
import { defaultLang, locales, routeSlugs } from "../../i18n/config";

/**
 * Prefixed-locale sub-pages (e.g. /de/tandemflug-buchen).
 * Default-locale sub-pages are handled by pages/[slug].astro.
 */
export function getStaticPaths() {
  return locales
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({
      params: { lang, slug: routeSlugs.booking[lang] },
      props: { page: "booking" as const },
    }));
}

const { page } = Astro.props;
---

<Layout>
  {page === "booking" && <Booking />}
</Layout>
