---
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang } from "../i18n/config";

// Root entry point: redirect to the default locale (e.g. /tandem-v3/en/).
const target = getRelativeLocaleUrl(defaultLang, "/");
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Let's Fly · Tandem Paragliding in the Dolomites</title>
  </head>
  <body>
    <a href={target}>Continue</a>
  </body>
</html>
