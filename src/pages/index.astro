---
import Layout from "../layouts/Layout.astro";
import Hero from "../sections/Hero/Hero.astro";
import Flights from "../sections/Flights/Flights.astro";
import Process from "../sections/Process/Process.astro";
import Location from "../sections/Location/Location.astro";
import Reviews from "../sections/Reviews/Reviews.astro";
import Faq from "../sections/Faq/Faq.astro";
import Cta from "../sections/Cta/Cta.astro";
import Footer from "../sections/Footer/Footer.astro";
import { defaultLang } from "../i18n/config";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(defaultLang);

// Coordinates and images are not translatable; labels come from the dictionary.
const locationMeta = [
  {
    coordinates: [46.645, 11.749] as [number, number],
    imageUrls: ["/tandem-v3/img/1.jpg", "/tandem-v3/img/2.jpg"],
  },
  {
    coordinates: [46.704, 11.686] as [number, number],
    imageUrls: ["/tandem-v3/img/2.jpg", "/tandem-v3/img/3.jpg"],
  },
];

const locations = t.location.items.map((item, i) => ({
  ...item,
  ...locationMeta[i],
}));

const priceAmount = (price: string) => price.replace(/[^\d]/g, "");

// Same images as FlightCard in Flights.astro
const flightImages = [
  "/tandem-v3/img/1.jpg",
  "/tandem-v3/img/2.jpg",
  "/tandem-v3/img/3.jpg",
];

const productsData = {
  "@context": "https://schema.org",
  "@graph": t.flights.items.map((flight, i) => ({
    "@type": "Product",
    name: flight.title,
    description: flight.description,
    image: flightImages[i]
      ? new URL(flightImages[i], Astro.site).href
      : undefined,
    offers: {
      "@type": "Offer",
      priceCurrency: "EUR",
      price: priceAmount(flight.price),
      availability: "https://schema.org/InStock",
    },
  })),
};
---

<Layout>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="preload" as="image" href="/tandem-v3/img/hero.webp">
    <script type="application/ld+json" set:html={JSON.stringify(productsData)} />
  </Fragment>
	<Hero />
	<Flights />
	<Location locations={locations} />
	<Reviews />
	<Process />
	<Faq />
	<Cta />
	<Footer />
</Layout>
